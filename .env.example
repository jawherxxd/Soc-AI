# ══════════ PIPELINE (pipeline/config/.env) ══════════

# ── Database ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socdb
DB_USER=socuser
DB_PASSWORD=change_me

# ── Redis (alert deduplication) ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60

# ── Wazuh ────────────────────────────────
WAZUH_HOST=10.10.10.252
WAZUH_PORT=55000
WAZUH_USER=wazuh_api_user
WAZUH_PASSWORD=change_me

# ── Threat intelligence ──────────────────
ABUSEIPDB_KEY=your_abuseipdb_key
GEOIP_DB=./GeoLite2-City.mmdb
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=your_nvd_key_optional

# ── LLM (any OpenAI-compatible endpoint) ─
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_API_KEY=your_llm_api_key
LLM_MAX_TOKENS=1000

# ── Pipeline webhook ─────────────────────
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8000

# ── Correlation & triage tuning ──────────
DEDUP_WINDOW_SECONDS=60
CORRELATION_WINDOW_SECONDS=300
CASE_SEVERITY_THRESHOLD=5
FP_THRESHOLD=0.7

# ── iTop ITSM ────────────────────────────
ITOP_URL=http://10.10.10.200/webservices/rest.php
ITOP_USER=soc_api
ITOP_PASSWORD=change_me
ITOP_ORG=SOC-Lab
ITOP_ANALYST_ID=3
ITOP_ANALYST_NAME=analyst
ITOP_ANALYST_FIRSTNAME=soc
ITOP_TEAM_ID=2
ITOP_TEAM_NAME=SOC Tier 1


# ══════════ BACKEND (backend/.env) ══════════

DB_HOST=localhost
DB_PORT=5432
DB_NAME=socdb
DB_USER=socuser
DB_PASSWORD=change_me

UI_HOST=0.0.0.0
UI_PORT=8080

# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_a_long_random_value
DEMO_PASSWORD=choose_a_strong_password

ITOP_URL=http://10.10.10.200/webservices/rest.php
ITOP_USER=soc_api
ITOP_PASSWORD=change_me

N8N_CONTAINMENT_URL=http://localhost:5678/webhook/containment
